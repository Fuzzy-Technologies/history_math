{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:felab:history-math:article:1",
  "title": "History Math publication package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "article_id", "source_work_id", "layout", "title", "authors", "author", "lang", "translation_key", "description", "type", "tags", "math", "status", "permalink", "rights_basis"],
  "properties": {
    "schema_version": {"const": 1},
    "article_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "source_work_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$"},
    "layout": {"const": "article"},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "author": {"type": "string", "minLength": 1},
    "lang": {"enum": ["en", "ru"]},
    "translation_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "description": {"type": "string", "minLength": 1},
    "type": {"enum": ["essay", "problem", "instrument", "note"]},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "math": {"type": "boolean"},
    "status": {"enum": ["draft", "published", "demo"]},
    "permalink": {"type": "string", "pattern": "^/(ru/)?articles/[a-z0-9-]+/$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "original_publication": {
      "type": "object", "additionalProperties": false, "required": ["outlet"],
      "properties": {
        "outlet": {"type": "string", "minLength": 1},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "url": {"type": "string", "pattern": "^https://"},
        "citation": {"type": "string", "minLength": 1}
      }
    },
    "source_url": {"type": "string", "pattern": "^https://"},
    "rights_basis": {"type": "string", "minLength": 1},
    "series": {"type": "string", "minLength": 1},
    "preview_image": {"type": "string", "pattern": "^/assets/images/[a-z0-9-]+/[a-zA-Z0-9._-]+$"},
    "cover_image": {"type": "string", "pattern": "^/assets/images/[a-z0-9-]+/[a-zA-Z0-9._-]+$"},
    "hero_image": {"type": "string", "pattern": "^/assets/images/[a-z0-9-]+/[a-zA-Z0-9._-]+$"},
    "hero_alt": {"type": "string", "minLength": 1},
    "hero_caption": {"type": "string", "minLength": 1},
    "figures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "alt", "caption", "source", "rights_basis"],
        "properties": {
          "id": {"type": "string", "pattern": "^fig-[a-z0-9-]+$"},
          "path": {"type": "string", "pattern": "^/assets/images/[a-z0-9-]+/[a-zA-Z0-9._-]+$"},
          "alt": {"type": "string", "minLength": 1},
          "caption": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "pattern": "^https://"},
          "rights_basis": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "license_url": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "editorial_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["published", "demo"]}}}, "then": {"required": ["date"]}},
    {"if": {"required": ["hero_image"]}, "then": {"required": ["hero_alt", "hero_caption"]}}
  ]
}
